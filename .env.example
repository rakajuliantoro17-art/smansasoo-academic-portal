# ==========================================================
# SMANSASOO Academic Portal - Environment Variables
# Salin isi file ini ke Vercel Project Settings > Environment
# Variables (JANGAN commit file .env asli berisi nilai nyata).
# ==========================================================

# ---------- Modul Nilai / Rekap / Pengumuman ----------
# ID spreadsheet (lihat di URL-nya, bagian setelah /d/ dan
# sebelum /edit). Contoh:
# https://docs.google.com/spreadsheets/d/1iYWwaL81QnuieTkuke8MmhLp9NLYJSU9vkgxMT84hMI/edit
GOOGLE_SHEET_ID=

# Opsional: spreadsheet khusus per tahun ajaran, contoh untuk
# tahun 2026 -> GOOGLE_SHEET_ID_2026=. Kalau tidak diisi,
# otomatis jatuh ke GOOGLE_SHEET_ID di atas.
# GOOGLE_SHEET_ID_2026=

# ---------- Statistik Pengunjung (Upstash Redis) ----------
# Buat gratis di https://console.upstash.com -> Create Database
# -> buka tab "REST API" -> salin UPSTASH_REDIS_REST_URL &
# UPSTASH_REDIS_REST_TOKEN. Kalau dikosongkan, panel statistik
# otomatis tampil "belum diaktifkan" tanpa error ke pengguna.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Absensi QR (kamera) ----------
# Spreadsheet KHUSUS absensi, terpisah dari spreadsheet nilai
# di atas. Harus punya 2 tab:
#   STUDENTS -> kolom: NIS | Nama | Kelas  (baris 1 = header)
#   ABSENSI  -> kolom: Tanggal | Waktu | NIS | Nama | Kelas |
#               Mapel | Jam Ke | Status   (baris 1 = header,
#               BARIS DATA diisi otomatis oleh sistem, jangan
#               diisi manual)
GOOGLE_SHEET_ID_ABSENSI=

# Service Account Google Cloud (WAJIB untuk menulis ke sheet
# ABSENSI -- beda dengan GOOGLE_SHEET_ID yang cukup dibaca
# publik). Cara dapatnya:
#   1. console.cloud.google.com -> buat project -> aktifkan
#      "Google Sheets API".
#   2. IAM & Admin > Service Accounts -> Create -> buat key
#      baru bertipe JSON -> file-nya otomatis terdownload.
#   3. Share spreadsheet absensi (langkah di atas) ke email
#      "client_email" dari file JSON itu, sebagai Editor.
#   4. Isi dua variabel di bawah dari isi file JSON tadi.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Nilai "private_key" dari file JSON. Kalau ditempel sebagai
# satu baris di Vercel, ganti setiap baris baru jadi "\n"
# literal (sistem akan mengembalikannya otomatis).
GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------- Login Admin (gerbang halaman Absensi) ----------
# Melindungi pages/absensi-scan.html, absensi-admin.html, dan
# absensi-rekap.html + API-nya dengan username/password, supaya
# tidak sembarang orang bisa mencetak QR, scan, atau melihat
# rekap.
#
# SAAT INI username/password SUDAH AKTIF lewat default yang
# tertanam di kode (api/admin-login.js) -- TIDAK perlu mengisi
# apa pun di sini untuk mulai memakainya. Isi tiga variabel di
# bawah HANYA kalau suatu saat mau mengganti username/password
# tanpa mengubah kode (nilai di sini otomatis mengambil alih
# default di kode):
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Opsional: string acak panjang untuk menandatangani token sesi.
# Kalau kosong, diturunkan otomatis dari ADMIN_PASSWORD di atas.
# ADMIN_SESSION_SECRET=
